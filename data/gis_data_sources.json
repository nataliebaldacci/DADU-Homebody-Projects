      "name": "Zoning Overlay Districts (Metro Nashville)",
      "url": "https://maps.nashville.gov/arcgis/rest/services/Zoning_Landuse/Zoning_Overlay_Districts/MapServer/0",
      "description": "Official Metro Nashville zoning overlays",
      "queryExamples": {
        "daduOverlay": "ZONE_DESC = 'Detached Accessory Dwelling Unit Overlay District'",
        "allOverlays": "1=1 (with returnDistinctValues on ZONE_DESC)"
      }
    },
    "zoningOverlaysView": {
      "name": "Zoning Overlay Districts View (ArcGIS Online)",
      "url": "https://services2.arcgis.com/HdTo6HJqh92wn4D8/arcgis/rest/services/Zoning_Overlay_Districts_Vw/FeatureServer/0",
      "description": "Zoning overlays mirrored to ArcGIS Online (CORS-friendly)",
      "queryExamples": {
        "urbanDesignOverlays": "zone_desc like '%Urban Design Overlay%'",
        "fields": "OBJECTID,ZONE_DESC,CASE_NO,ORDINANCE,ORD_DATE,NAME,IMPACT_ZONE,SUBDISTRICT"
      }
    },
    "usdGsdBoundary": {
      "name": "USD/GSD Boundary",
      "url": "https://maps.nashville.gov/arcgis/rest/services/Boundaries/USD_GSD/MapServer/0",
