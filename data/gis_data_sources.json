    },
    "addressPoints": {
      "name": "Nashville Address Points",
      "url": "https://maps.nashville.gov/arcgis/rest/services/Addressing/AddressPoints/MapServer/0",
      "description": "Official address points with descriptions and link types",
      "queryExamples": {
        "daduAddresses": "Description like '%DADU%' OR DESCRIPTION LIKE '%ACCESSORY DWELL%' OR DESCRIPTION LIKE '%Carriage%'",
        "guestHouses": "Description like '%dadu%' or description like '%guest%'",
        "nonPrimaryAddresses": "LinkTypeCode <> 'P'",
        "secondaryAddresses": "Fraction LIKE '%B%' AND LinkTypeCode = 'E'"
      },
      "note": "LinkTypeCode E = secondary/accessory address. Description 'GARAGE / DADU' or 'DETACHED HOUSE IN REAR' indicates ADU."
    },
    "parcelHistory": {
      "name": "Parcel Zoning History",
      "url": "https://maps.nashville.gov/arcgis2/rest/services/Parcels/ParcelHistory/MapServer/5",
      "description": "Historical parcel zoning changes",
      "queryExamples": {
        "udoOverlays": "ZoneCode = 'OV-UDO'",
        "fields": "Zonecode,OrdinanceNumber,DateEffective,Casenumber,Status,url,sortdate"
      }
    }
